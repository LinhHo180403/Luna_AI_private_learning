# backend/.env.example
# Copy file này thành ".env" và điền giá trị thật.
# QUAN TRỌNG: không commit file .env thật lên git.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- AI Provider ---
# Giá trị hợp lệ: offline | nara
# "offline" = rule-based, KHONG can API key, dung cho dev/test hang ngay.
# "nara"    = goi NaraRouter API that, BAT BUOC phai co AI_API_KEY.
AI_PROVIDER=offline
AI_API_KEY=
AI_MODEL=deepseek-3.2
AI_BASE_URL=https://api.nararouter.com/v1
AI_TIMEOUT_MS=20000

# --- Session ---
MAX_HISTORY_MESSAGES=12

# --- Memory ---
MEMORY_FILE_PATH=./memory/memory.json

# --- Misc ---
DEBUG_LOG=true
CORS_ORIGIN=http://localhost:5173
